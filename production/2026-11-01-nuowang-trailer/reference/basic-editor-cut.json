      "id": "nuowang-speech-v1",
      "asset_id": "a1fedb62a30543cfa4588c57768013ce",
      "label": "有些人，看得见另一个人间。",
      "start_ms": 2000,
      "in_ms": 0,
      "out_ms": 2976,
      "gain": 1.25
    },
    {
      "id": "nuowang-speech-v2",
      "asset_id": "c74cdd7c5c1d499da84b1d4be0ffef6b",
      "label": "一个少年。一位七百年前的将军。",
      "start_ms": 16200,
      "in_ms": 0,
      "out_ms": 3216,
      "gain": 1.25
    },
    {
      "id": "nuowang-speech-v3",
      "asset_id": "4e840284eac14667adc75768b3438580",
      "label": "六十年一会。每个人，都想赢回自己的愿望。",
      "start_ms": 31500,
      "in_ms": 0,
      "out_ms": 4920,
      "gain": 1.25
    },
    {
      "id": "nuowang-speech-v4",
      "asset_id": "2afa8411034b423792b36aab664b1be0",
      "label": "他最信任的人，也是他必须追上的人。",
      "start_ms": 46000,
      "in_ms": 0,
      "out_ms": 3408,
      "gain": 1.25
    },
    {
      "id": "nuowang-speech-v5",
      "asset_id": "3da01ca0509f49d5920cc96f43d27d63",
      "label": "若要守住人间，就不能放弃任何一个回家的愿望。",
      "start_ms": 61000,
      "in_ms": 0,
      "out_ms": 4488,
      "gain": 1.25
    },
    {
      "id": "nuowang-speech-v6",
      "asset_id": "70e13ebac59c4041bb82ed48fcfbb747",
      "label": "师兄，我想带你回家。",
      "start_ms": 77500,
      "in_ms": 0,
      "out_ms": 2136,
      "gain": 1.25
    }
