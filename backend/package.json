{
  "name": "ai-video-studio-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node ../scripts/clean-build.mjs backend && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "langfuse:check": "node --import tsx scripts/langfuse.ts check",
    "langfuse:smoke": "node --import tsx scripts/langfuse.ts smoke"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@video-studio/shared": "file:../packages/shared",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.34.0",
    "yaml": "^2.9.1",
    "yazl": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
