# Optional Langfuse metadata tracing. This file contains no credentials.
# For local self-hosting, run: npm run langfuse:local -- setup
# It creates ignored .env.langfuse.local and .env.langfuse.docker.local files.
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3035
# Sample whole traces: 1 means all, 0 means none.
LANGFUSE_TRACING_SAMPLING_RATE=1
# Limits apply only to trace export, not model-generation budgets.
VIDEO_STUDIO_LANGFUSE_TIMEOUT_MS=3000
VIDEO_STUDIO_LANGFUSE_MAX_PENDING=256
