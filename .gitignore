node_modules/
web/dist/
backend/dist/
packages/*/dist/
data/
*.tsbuildinfo
.DS_Store
__pycache__/
*.py[cod]

# Local environment secrets; keep explicitly named examples shareable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Private keys and local keystores.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_ecdsa_sk
id_ed25519_sk

# Local database copies, SQLite sidecars, and database backups.
*.db
*.db-*
*.db.bak
*.db.bak.*
*.db.backup
*.db.backup.*
*.sqlite
*.sqlite-*
*.sqlite.bak
*.sqlite.bak.*
*.sqlite.backup
*.sqlite.backup.*
*.sqlite3
*.sqlite3-*
*.sqlite3.bak
*.sqlite3.bak.*
*.sqlite3.backup
*.sqlite3.backup.*

# Local agent plans and task artifacts; existing tracked records remain intact.
.planning/

# Generated exports and local media
exports/*
!exports/.gitkeep

# Keep production scripts and validation records in Git; media stays local.
production/**/*.png
production/**/*.jpg
production/**/*.jpeg
production/**/*.webp
production/**/*.mp4
production/**/*.mov
production/**/*.mp3
production/**/*.wav
production/**/*.m4a
